{
  "default_model": "gpt-4o",

  "models": {
    "gpt-4o": {
      "provider": "openai",
      "model": "gpt-4o",
      "context_window": 128000,
      "max_tokens": 16384,
      "temperature": 0.2,
      "input_cost": 2.5,
      "output_cost": 10.0,
      "max_retries": 4,
      "fallback": ["gpt-4o-openrouter", "claude-sonnet"]
    },
    "gpt-4o-openrouter": {
      "provider": "openrouter",
      "model": "openai/gpt-4o",
      "context_window": 128000,
      "max_tokens": 16384
    },
    "gpt-4o-mini": {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "context_window": 128000,
      "max_tokens": 16384,
      "input_cost": 0.15,
      "output_cost": 0.6
    },
    "gpt-4.1": {
      "provider": "openai",
      "model": "gpt-4.1",
      "context_window": 1000000,
      "max_tokens": 32768,
      "input_cost": 2.0,
      "output_cost": 8.0
    },
    "o3-mini": {
      "provider": "openai",
      "model": "o3-mini",
      "context_window": 200000,
      "max_tokens": 100000,
      "reasoning_effort": "medium",
      "input_cost": 1.1,
      "output_cost": 4.4
    },

    "claude-sonnet": {
      "provider": "anthropic",
      "model": "claude-3-7-sonnet-latest",
      "context_window": 200000,
      "max_tokens": 8192,
      "temperature": 0.2,
      "input_cost": 3.0,
      "output_cost": 15.0
    },
    "claude-haiku": {
      "provider": "anthropic",
      "model": "claude-3-5-haiku-latest",
      "context_window": 200000,
      "max_tokens": 8192,
      "input_cost": 0.8,
      "output_cost": 4.0
    },

    "gemini-flash": {
      "provider": "google",
      "model": "gemini-2.0-flash",
      "context_window": 1000000,
      "max_tokens": 8192,
      "input_cost": 0.1,
      "output_cost": 0.4
    },
    "gemini-pro": {
      "provider": "google",
      "model": "gemini-1.5-pro",
      "context_window": 2000000,
      "max_tokens": 8192,
      "input_cost": 1.25,
      "output_cost": 5.0
    },

    "deepseek-chat": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "context_window": 64000,
      "max_tokens": 8192,
      "temperature": 0.2,
      "input_cost": 0.27,
      "output_cost": 1.1
    },
    "deepseek-reasoner": {
      "provider": "deepseek",
      "model": "deepseek-reasoner",
      "context_window": 64000,
      "max_tokens": 8192,
      "input_cost": 0.55,
      "output_cost": 2.19
    },

    "grok": {
      "provider": "xai",
      "model": "grok-2-latest",
      "context_window": 131072,
      "max_tokens": 8192,
      "input_cost": 2.0,
      "output_cost": 10.0
    },

    "mistral-large": {
      "provider": "mistral",
      "model": "mistral-large-latest",
      "context_window": 128000,
      "max_tokens": 8192,
      "input_cost": 2.0,
      "output_cost": 6.0
    },
    "codestral": {
      "provider": "mistral",
      "model": "codestral-latest",
      "context_window": 256000,
      "max_tokens": 8192,
      "temperature": 0.1,
      "input_cost": 0.3,
      "output_cost": 0.9
    },

    "llama-groq": {
      "provider": "groq",
      "model": "llama-3.3-70b-versatile",
      "context_window": 128000,
      "max_tokens": 32768,
      "input_cost": 0.59,
      "output_cost": 0.79
    },
    "llama-groq-fast": {
      "provider": "groq",
      "model": "llama-3.1-8b-instant",
      "context_window": 128000,
      "max_tokens": 8192,
      "input_cost": 0.05,
      "output_cost": 0.08
    },

    "llama-cerebras": {
      "provider": "cerebras",
      "model": "llama-3.3-70b",
      "context_window": 128000,
      "max_tokens": 8192,
      "input_cost": 0.85,
      "output_cost": 1.2
    },

    "qwen-coder-together": {
      "provider": "together",
      "model": "Qwen/Qwen2.5-Coder-32B-Instruct",
      "context_window": 32768,
      "max_tokens": 8192,
      "temperature": 0.1,
      "input_cost": 0.8,
      "output_cost": 0.8
    },

    "llama-fireworks": {
      "provider": "fireworks",
      "model": "accounts/fireworks/models/llama-v3p3-70b-instruct",
      "context_window": 128000,
      "max_tokens": 8192,
      "input_cost": 0.9,
      "output_cost": 0.9
    },

    "openrouter-sonnet": {
      "provider": "openrouter",
      "model": "anthropic/claude-3.7-sonnet",
      "context_window": 200000,
      "max_tokens": 8192,
      "input_cost": 3.0,
      "output_cost": 15.0,
      "extra_headers": {
        "HTTP-Referer": "https://github.com/krishnavams/coded",
        "X-Title": "coded"
      }
    },

    "sonar": {
      "provider": "perplexity",
      "model": "sonar-pro",
      "context_window": 200000,
      "max_tokens": 8192,
      "supports_tools": false,
      "input_cost": 3.0,
      "output_cost": 15.0
    },

    "kimi": {
      "provider": "moonshot",
      "model": "kimi-k2-0711-preview",
      "context_window": 128000,
      "max_tokens": 8192,
      "input_cost": 0.6,
      "output_cost": 2.5
    },

    "qwen-local": {
      "provider": "ollama",
      "model": "qwen2.5-coder:7b",
      "context_window": 32768,
      "max_tokens": 8192,
      "temperature": 0.2
    },
    "llama-local": {
      "provider": "ollama",
      "model": "llama3.1:8b",
      "context_window": 128000,
      "max_tokens": 8192
    },
    "lmstudio-local": {
      "provider": "lmstudio",
      "model": "your-loaded-model-id",
      "context_window": 32768,
      "max_tokens": 8192
    },
    "vllm-local": {
      "provider": "vllm",
      "model": "meta-llama/Llama-3.1-8B-Instruct",
      "context_window": 128000,
      "max_tokens": 8192
    },

    "custom": {
      "provider": "openai-compatible",
      "model": "my-model-id",
      "base_url": "http://localhost:9000/v1",
      "api_key_env": "MY_API_KEY",
      "context_window": 32768,
      "max_tokens": 4096,
      "supports_tools": true
    },
    "corp-internal": {
      "provider": "openai-compatible",
      "model": "internal-llm",
      "base_url": "https://llm.internal/v1",
      "api_key_env": "INTERNAL_API_KEY",
      "ca_bundle": "/etc/ssl/corp-ca.pem"
    },
    "big-700b": {
      "provider": "openai-compatible",
      "base_url": "https://llm.internal.example.com/v1",
      "api_key_env": "INTERNAL_API_KEY",
      "model": "your-700b-model",
      "context_window": 300000,
      "timeout": 900,
      "fallback_cooldown": 120,
      "max_tokens": 32000,
      "max_turns": 400,
      "prompt_profile": "full",
      "repo_overview": true,
      "limits": {"read_lines": 8000, "shell_output_chars": 120000},
      "fallback": ["gpt-4.1"]
    },
    "small-local": {
      "provider": "ollama",
      "model": "qwen2.5-coder:7b",
      "context_window": 32768,
      "prompt_profile": "compact",
      "prompts_dir": ".coded/prompts-small"
    },
    "self-signed": {
      "provider": "openai-compatible",
      "model": "local-llm",
      "base_url": "https://192.168.1.5/v1",
      "verify_ssl": false
    }
  },

  "embedding": {
    "provider": "openai",
    "model": "text-embedding-3-small"
  },

  "web_search": {
    "backend": "tavily",
    "api_key_env": "TAVILY_API_KEY"
  },

  "mcp_servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": false
    }
  },

  "permissions": {
    "allow": ["bash(git *)", "bash(pytest*)"],
    "deny": ["bash(rm -rf*)"]
  },

  "model_roles": {
    "subagent": "gpt-4o-mini",
    "compact": "gpt-4o-mini",
    "review": "gpt-4o",
    "verdict": "gpt-4o",
    "plan": "gpt-4o"
  },

  "// pools": "Interchangeable models behind one name; usable anywhere an alias is.",
  "pools": {
    "frontier": ["gpt-4o", "claude-sonnet"]
  },

  "// routing": "Pick the model per request by how hard it looks (off by default).",
  "routing": {
    "enabled": false,
    "simple": "gpt-4o-mini",
    "medium": "gpt-4o",
    "hard": "frontier",
    "sticky": true,
    "rules": [{"match": "(?i)^deploy\\b", "level": "hard"}]
  },

  "hooks": {
    "PostToolUse": [
      {"matcher": "edit|multi_edit|write|apply_patch", "command": "git diff --stat"}
    ]
  },

  "sandbox": {
    "enabled": false,
    "network": false,
    "writable": ["~/.cache"]
  },

  "telemetry": {
    "jsonl": "~/.cache/coded/trace.jsonl",
    "otel": false
  },

  "injection_guard": "warn",
  "show_reasoning": false,
  "parallel_tools": true,

  "detect_external_agents": true,
  "external_agents": {
    "claude": {"command": ["claude", "-p", "{prompt}"], "timeout": 1800}
  },

  "auto_approve": false,
  "// verify": "After a turn that changed something, run the project's own checks and, with model_roles.verify set, have a second model review the diff. Either complaint goes back to the agent, up to max_rounds times. Both halves are off until configured.",
  "verify": {
    "command": null,
    "second_opinion": false,
    "max_rounds": 2,
    "timeout": 300
  },
  "auto_compact": true,
  "// auto_fallback": "When a model fails and its own fallbacks are exhausted (or it has none), try the other configured models before giving up. This can send a request to a different provider than the one you selected.",
  "auto_fallback": true,
  "// disabled_tools": "Tools never offered to the model, by name or pattern. Each tool's definition is sent with every request, so dropping unused ones makes every step faster. Models can disable more with their own \"disabled_tools\".",
  "disabled_tools": [],
  "compact_ratio": 0.8,
  "max_turns": 100,
  "auto_extend_turns": true,
  "stream": true
}
